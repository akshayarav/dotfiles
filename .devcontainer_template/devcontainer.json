{
  "name": "Terminal Workspace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=${localEnv:HOME}/projects/dotfiles,target=/home/vscode/dotfiles,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "~/dotfiles/install.sh && nvim --headless '+Lazy! sync' +qa"
}
