{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(fdfind:*)",
      "Bash(tree:*)",
      "Bash(which:*)"
    ],
    "deny": [
      "Bash(sudo:*)"
    ]
  },
  "tui": "default",
  "theme": "custom:tokyonight",
  "preferredNotifChannel": "iterm2",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  }
}
